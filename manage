<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="format-detection" content="telephone=no">
<meta name="applicable-device" content="mobile">
<meta name="renderer" content="webkit" />
<meta name="force-rendering" content="webkit" />
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover"/>
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content="今日热榜" />
<meta name="theme-color" content="#ffffff" />
<title>注册/登录/今日热榜</title>
<style>
:root{--primary-color:#ff416c;--secondary-color:#ff4b2b;--text-color:#333;--bg-color:#f8f9fa;--card-bg:rgba(255, 255, 255, 0.9);--input-bg:rgba(238, 238, 238, 0.7);--shadow-color:rgba(0, 0, 0, 0.1);--border-radius:16px;--button-radius:30px;--transition-speed:0.3s}
@media (prefers-color-scheme:dark){:root{--text-color:#f8f9fa;--bg-color:#121212;--card-bg:rgba(30, 30, 30, 0.8);--input-bg:rgba(50, 50, 50, 0.7);--shadow-color:rgba(0, 0, 0, 0.3)}
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg-color);background-image:linear-gradient(135deg,#f5f7fa 0,#c3cfe2 100%);display:flex;justify-content:center;align-items:center;flex-direction:column;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Oxygen,Ubuntu,Cantarell,'Open Sans','Helvetica Neue',sans-serif;min-height:100vh;margin:0;padding:20px;transition:background-color var(--transition-speed) ease}
@media (prefers-color-scheme:dark){body{background-image:linear-gradient(135deg,#0f172a 0,#1e293b 100%)}
}
h1{font-weight:700;margin:0 0 15px 0;font-size:28px;color:var(--text-color)}
h2{text-align:center;color:var(--text-color)}
p{font-size:14px;line-height:1.6;letter-spacing:.5px;color:var(--text-color)}
span{font-size:14px;color:var(--text-color)}
a{color:var(--primary-color);font-size:14px;text-decoration:none;margin:15px 0;transition:color var(--transition-speed) ease}
a:hover{text-decoration:underline}
button{border-radius:var(--button-radius);border:none;background:linear-gradient(45deg,var(--primary-color),var(--secondary-color));color:#fff;font-size:14px;font-weight:600;padding:12px 45px;letter-spacing:1px;text-transform:uppercase;transition:all var(--transition-speed) ease;cursor:pointer;box-shadow:0 4px 15px var(--shadow-color)}
button:hover{transform:translateY(-2px);box-shadow:0 7px 20px var(--shadow-color)}
button:active{transform:translateY(1px);box-shadow:0 2px 10px var(--shadow-color)}
button:focus{outline:0}
button.ghost{background:0 0;border:2px solid #fff;background-color:rgba(255,255,255,.1);backdrop-filter:blur(5px);margin-top:30px;}
button.ghost:hover{background-color:rgba(255,255,255,.2)}
form{background-color:var(--card-bg);display:flex;align-items:center;justify-content:center;flex-direction:column;padding:0 50px;height:100%;text-align:center;backdrop-filter:blur(10px);gap:5px;}
input{background-color:var(--input-bg);border:none;padding:15px;margin:10px 0;width:100%;border-radius:12px;outline:0;font-size:14px;color:var(--text-color);transition:all var(--transition-speed) ease;box-shadow:inset 0 2px 4px rgba(0,0,0,.05)}
input:focus{box-shadow:inset 0 2px 4px rgba(0,0,0,.1),0 0 0 3px rgba(var(--primary-color-rgb),.1)}
.container{background-color:var(--card-bg);border-radius:var(--border-radius);box-shadow:0 15px 35px var(--shadow-color);position:relative;overflow:hidden;width:868px;max-width:100%;min-height:550px;backdrop-filter:blur(10px)}
.form-container{position:absolute;top:0;height:100%;transition:all .6s ease-in-out}
.sign-in-container{left:0;width:50%;z-index:2}
.container.right-panel-active .sign-in-container{transform:translateX(100%)}
.sign-up-container{left:0;width:50%;opacity:0;z-index:1}
.container.right-panel-active .sign-up-container{transform:translateX(100%);opacity:1;z-index:5;animation:show .6s}
@keyframes show{0%,49.99%{opacity:0;z-index:1}
100%,50%{opacity:1;z-index:5}
}
.overlay-container{position:absolute;top:0;left:50%;width:50%;height:100%;overflow:hidden;transition:transform .6s ease-in-out;z-index:100}
.container.right-panel-active .overlay-container{transform:translateX(-100%)}
.overlay{background:linear-gradient(135deg,var(--primary-color) 0,var(--secondary-color) 100%);background-repeat:no-repeat;background-size:cover;background-position:0 0;color:#fff;position:relative;left:-100%;height:100%;width:200%;transform:translateX(0);transition:transform .6s ease-in-out}
.overlay h1, .overlay p, .overlay button {color:#fff}
.container.right-panel-active .overlay{transform:translateX(50%)}
.overlay-panel{position:absolute;display:flex;align-items:center;justify-content:center;flex-direction:column;padding:0 40px;text-align:center;top:0;height:100%;width:50%;transform:translateX(0);transition:transform .6s ease-in-out}
.overlay-left{transform:translateX(-20%)}
.container.right-panel-active .overlay-left{transform:translateX(0)}
.overlay-right{right:0;transform:translateX(0)}
.container.right-panel-active .overlay-right{transform:translateX(20%)}
.social-container{margin:20px 0;display:flex;flex-wrap:wrap;justify-content:center}
.social-container a{border:1px solid rgba(255,255,255,.3);border-radius:50%;display:inline-flex;justify-content:center;align-items:center;margin:0;height:50px;width:50px;transition:all var(--transition-speed) ease;background-color:rgba(255,255,255,.1);backdrop-filter:blur(5px)}
.social-container a:hover{transform:translateY(-3px);box-shadow:0 7px 15px rgba(0,0,0,.1);background-color:rgba(255,255,255,.2)}
.social-container a img{height:30px;width:30px;transition:transform var(--transition-speed) ease}
.social-container a:hover img{transform:scale(1.1)}
.code{font-size:14px;line-height:1.5;color:var(--text-color);box-sizing:border-box;margin:0;padding:0;list-style:none;position:relative;display:inline-block;width:100%}
.sendcode{position:absolute;top:50%;z-index:2;transform:translateY(-50%);line-height:0;color:var(--text-color);right:12px}
.sendcode button{border-radius:8px;padding:8px 12px;font-weight:500;font-size:12px;background:linear-gradient(45deg,var(--primary-color),var(--secondary-color))}
.header{width:868px;max-width:100%;margin:0 auto;padding:10px;display:flex;align-items:center;justify-content:space-between}
.header a{color:var(--primary-color);font-weight:600;font-size:18px;display:flex;align-items:center;transition:all var(--transition-speed) ease;gap:5px;z-index:20000;}
.header a:hover{transform:translateY(-2px);text-decoration:none}

/* 登录提示容器和提示样式 */
.login-tip-container {
  position: absolute;
  top: 60px;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  z-index: 100;
  padding: 0 15px;
  box-sizing: border-box;
}

.login-tip {
  background: linear-gradient(to right, rgba(var(--primary-color-rgb), 0.9), rgba(var(--secondary-color-rgb), 0.9));
  color: white;
  padding: 10px 16px;
  border-radius: 20px;
  font-size: 14px;
  font-weight: 500;
  box-shadow: 0 4px 15px rgba(var(--primary-color-rgb), 0.3);
  animation: pulse 2s infinite;
  display: flex;
  align-items: center;
  letter-spacing: 0.5px;
  backdrop-filter: blur(5px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  max-width: 100%;
  box-sizing: border-box;
}

#login-tip-text {
  flex: 1;
  line-height: 1.4;
  word-break: break-word;
  min-width: 0;
}

.login-tip::before {
  content: '\2022'; /* 圆点符号 */
  color: #4cff4c;
  font-size: 18px;
  margin-right: 8px;
  animation: blink 1.5s infinite;
  text-shadow: 0 0 5px rgba(76, 255, 76, 0.7);
  flex-shrink: 0;
}

.close-tip {
  background: none;
  border: none;
  color: white;
  font-size: 20px;
  cursor: pointer;
  margin-left: 10px;
  opacity: 0.7;
  transition: opacity 0.2s;
  line-height: 1;
  padding: 0;
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 移动端优化 */
@media (max-width: 768px) {
  .login-tip-container {
    top: 50px;
    padding: 0 10px;
  }
  
  .login-tip {
    padding: 8px 12px;
    font-size: 13px;
    border-radius: 16px;
  }
  
  .login-tip::before {
    font-size: 16px;
    margin-right: 6px;
  }
  
  .close-tip {
    margin-left: 8px;
    font-size: 18px;
  }
}

@media (max-width: 480px) {
  .login-tip-container {
    top: 45px;
  }
  
  .login-tip {
    padding: 8px 10px;
    font-size: 12px;
    border-radius: 14px;
  }
  
  #login-tip-text {
    line-height: 1.3;
  }
  
  .login-tip::before {
    font-size: 14px;
    margin-right: 5px;
  }
  
  .close-tip {
    margin-left: 6px;
    font-size: 16px;
    width: 18px;
    height: 18px;
  }
}

.close-tip:hover {
  opacity: 1;
}

/* 高亮提示样式 */
.highlight-tip {
  animation: highlight-pulse 1.5s infinite !important;
  box-shadow: 0 5px 20px rgba(var(--primary-color-rgb), 0.5) !important;
}

@keyframes highlight-pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); }
}

@keyframes blink {
  0% { opacity: 0.5; }
  50% { opacity: 1; }
  100% { opacity: 0.5; }
}
@keyframes fadeIn{from{opacity:0;transform:translateY(20px)}
to{opacity:1;transform:translateY(0)}
}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(var(--primary-color-rgb),.7)}
70%{box-shadow:0 0 0 10px rgba(var(--primary-color-rgb),0)}
100%{box-shadow:0 0 0 0 rgba(var(--primary-color-rgb),0)}
}
@keyframes float{0%{transform:translateY(0)}
50%{transform:translateY(-6px)}
100%{transform:translateY(0)}
}
.container{animation:fadeIn .8s ease-out}
.pulse-effect:hover{animation:pulse 1.5s infinite}
.input-group{position:relative;width:100%;}
.input-group svg{position:absolute;left:15px;top:50%;transform:translateY(-50%);color:var(--primary-color);z-index:1;transition:all var(--transition-speed) ease}
.input-group input{padding-left:45px}
.input-group input:focus+svg{transform:translateY(-50%) scale(1.1);color:var(--secondary-color)}
.forgot-password{align-self:flex-end;margin-top:5px;font-size:13px;cursor:pointer;transition:all var(--transition-speed) ease}
.forgot-password:hover{color:var(--secondary-color);transform:translateX(-3px)}
.social-container a:hover img{animation:float 2s ease infinite}
@media (max-width:768px){
  .container{min-height:650px}
  .sign-in-container,.sign-up-container{width:100%}
  .overlay-container{display:none}
  .container.right-panel-active .sign-in-container{transform:translateX(-100%)}
  .container.right-panel-active .sign-up-container{transform:translateX(0)}
  .header a{font-size:16px}
  form{padding:0 30px}
  
  /* 移动版底部添加导航按钮 */
  .mobile-nav {
    display: flex;
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border-radius: 50px;
    padding: 10px 20px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
  }
  
  .mobile-nav button {
    margin: 0 10px;
    padding: 8px 20px;
    font-size: 12px;
  }
  
  /* 暗黑模式下的移动导航 */
  @media (prefers-color-scheme: dark) {
    .mobile-nav {
      background: rgba(30, 30, 30, 0.6);
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    }
  }
}
@media (prefers-color-scheme:dark){.input-group svg{color:rgba(255,255,255,.7)}
.input-group input:focus+svg{color:var(--primary-color)}
.container{box-shadow:0 15px 35px rgba(0,0,0,.4)}
}
:root{--primary-color-rgb:255,65,108;--secondary-color-rgb:255,75,43}

/* 现代科技感背景效果 */
.tech-background {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  overflow: hidden;
  pointer-events: none;
  background: linear-gradient(135deg, var(--bg-color) 0%, var(--bg-color) 100%);
}

/* 背景网格线 - 简化设计 */
.grid-lines {
  position: absolute;
  width: 100%;
  height: 100%;
  background-size: 40px 40px;
  background-image: 
    linear-gradient(to right, rgba(var(--primary-color-rgb), 0.05) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(var(--primary-color-rgb), 0.05) 1px, transparent 1px);
  opacity: 0.3;
}

/* 添加大网格线 - 更加微妙 */
.grid-lines::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-size: 200px 200px;
  background-image: 
    linear-gradient(to right, rgba(var(--primary-color-rgb), 0.08) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(var(--primary-color-rgb), 0.08) 1px, transparent 1px);
  z-index: -1;
}

/* 右上角装饰元素 - 更加简洁 */
.corner-decoration {
  position: absolute;
  top: 0;
  right: 0;
  width: 400px;
  height: 400px;
  background: radial-gradient(circle at top right, 
    rgba(var(--primary-color-rgb), 0.15) 0%, 
    rgba(var(--secondary-color-rgb), 0.08) 30%, 
    transparent 70%);
  z-index: -1;
  animation: pulse-glow 8s infinite alternate;
}

/* 左下角装饰元素 - 更加简洁 */
.bottom-decoration {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 200px;
  background: linear-gradient(to top, 
    rgba(var(--primary-color-rgb), 0.08) 0%, 
    transparent 100%);
  z-index: -1;
}

/* 左上角装饰 - 更加简洁 */
.tech-background::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 250px;
  height: 250px;
  background: radial-gradient(circle at top left, 
    rgba(var(--secondary-color-rgb), 0.1) 0%, 
    rgba(var(--primary-color-rgb), 0.05) 30%, 
    transparent 70%);
  z-index: -1;
  animation: pulse-glow 8s infinite alternate-reverse;
}

/* 右下角装饰已移除 */

@keyframes pulse-glow {
  0% { opacity: 0.5; filter: blur(5px); }
  100% { opacity: 0.8; filter: blur(10px); }
}

@keyframes rotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 鼠标跟随光效 - 更加简洁 */
.mouse-glow {
  position: fixed;
  width: 150px;
  height: 150px;
  border-radius: 50%;
  background: radial-gradient(
    circle at center,
    rgba(var(--primary-color-rgb), 0.15) 0%,
    rgba(var(--secondary-color-rgb), 0.05) 40%,
    transparent 70%
  );
  pointer-events: none;
  transform: translate(-50%, -50%);
  z-index: 9999;
  opacity: 0;
  transition: opacity 0.3s ease;
  mix-blend-mode: screen;
  filter: blur(8px);
}



/* 动画效果 */
@keyframes pulse-light {
  0% { opacity: 0.4; }
  50% { opacity: 0.7; }
  100% { opacity: 0.4; }
}

.pulse-light {
  animation: pulse-light 4s infinite ease-in-out;
}

/* 悬停效果 */
.hover-effect {
  transition: all 0.3s ease;
  transform: translateY(-2px);
  box-shadow: 0 7px 20px var(--shadow-color);
}

/* 添加表单元素的边框光效 */
input:focus {
  box-shadow: inset 0 2px 4px rgba(0,0,0,.1), 0 0 0 3px rgba(var(--primary-color-rgb), 0.2);
  animation: border-pulse 1.5s infinite;
}

@keyframes border-pulse {
  0% { box-shadow: inset 0 2px 4px rgba(0,0,0,.1), 0 0 0 3px rgba(var(--primary-color-rgb), 0.1); }
  50% { box-shadow: inset 0 2px 4px rgba(0,0,0,.1), 0 0 0 3px rgba(var(--primary-color-rgb), 0.2); }
  100% { box-shadow: inset 0 2px 4px rgba(0,0,0,.1), 0 0 0 3px rgba(var(--primary-color-rgb), 0.1); }
}

/* 按钮点击效果 */
button:active {
  transform: scale(0.98);
  box-shadow: 0 2px 10px var(--shadow-color);
}

/* 添加容器的微妙反光效果 */
.container {
  position: relative;
  overflow: hidden;
}

.container::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(to bottom right, 
    transparent, 
    transparent, 
    transparent, 
    rgba(255, 255, 255, 0.1), 
    transparent
  );
  transform: rotate(30deg);
  animation: shine 6s infinite linear;
  pointer-events: none;
}

@keyframes shine {
  0% { transform: translateX(-100%) rotate(30deg); }
  100% { transform: translateX(100%) rotate(30deg); }
}

/* 暗黑模式下的调整 */
@media (prefers-color-scheme: dark) {
  .grid-lines {
    background-image: 
      linear-gradient(to right, rgba(var(--primary-color-rgb), 0.1) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(var(--primary-color-rgb), 0.1) 1px, transparent 1px);
    opacity: 0.2;
  }
  
  .corner-decoration {
    background: radial-gradient(circle at top right, 
      rgba(var(--primary-color-rgb), 0.3) 0%, 
      rgba(var(--secondary-color-rgb), 0.15) 30%, 
      transparent 70%);
  }
}
</style>
