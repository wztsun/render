<script type="text/javascript">
// 页面切换动画
const container = document.getElementById("container");

document.getElementById("signUp").addEventListener("click", () => {
  container.classList.add("right-panel-active");
  document.getElementById("register").style.display = "block";
  document.getElementById("findpwd").style.display = "none";
});

document.getElementById("findPwd").addEventListener("click", () => {
  container.classList.add("right-panel-active");
  document.getElementById("register").style.display = "none";
  document.getElementById("findpwd").style.display = "block";
});

document.getElementById("signIn").addEventListener("click", () => {
  container.classList.remove("right-panel-active");
});

// 添加输入框焦点效果
const inputGroups = document.querySelectorAll(".input-group");
inputGroups.forEach((group) => {
  const input = group.querySelector("input");
  const icon = group.querySelector("svg");

  if (input && icon) {
    input.addEventListener("focus", () => {
      icon.style.color = "var(--secondary-color)";
    });

    input.addEventListener("blur", () => {
      icon.style.color = "";
    });
  }
});

// 添加按钮点击波纹效果
const buttons = document.querySelectorAll("button");
buttons.forEach((button) => {
  button.addEventListener("click", function (e) {
    const x = e.clientX - e.target.getBoundingClientRect().left;
    const y = e.clientY - e.target.getBoundingClientRect().top;

    const ripple = document.createElement("span");
    ripple.style.cssText = `
      position: absolute;
      background: rgba(255, 255, 255, 0.7);
      transform: translate(-50%, -50%);
      pointer-events: none;
      border-radius: 50%;
      width: 0;
      height: 0;
      left: ${x}px;
      top: ${y}px;
    `;

    button.appendChild(ripple);

    const size = Math.max(button.offsetWidth, button.offsetHeight);
    ripple.style.width = ripple.style.height = `${size}px`;

    setTimeout(() => ripple.remove(), 600);
  });
});

// 表单提交和验证码处理
$(document).ready(function () {
  // 加载验证码
  function loadCaptcha(formType) {
    $.ajax({
      type: "GET",
      dataType: "json",
      url: "/captcha/generate",
      success: function (data) {
        if (!data.error) {
          $('#' + formType + '-captcha-img').attr('src', data.data.image);
          $('#' + formType + 'form input[name="captcha_token"]').val(data.data.token);
        } else {
          layer.msg('验证码加载失败', { icon: 2 });
        }
      },
      error: function () {
        layer.msg('验证码加载失败', { icon: 2 });
      }
    });
  }

  // 页面加载时初始化验证码
  loadCaptcha('register');
  loadCaptcha('findpwd');

  // 点击验证码图片刷新
  $('#register-captcha-img, #findpwd-captcha-img').on('click', function() {
    var formType = $(this).attr('id').replace('-captcha-img', '');
    loadCaptcha(formType);
  });
  // 注册表单提交
  $("body").on("click", '#registerform button[type="submit"]', function () {
    const account = $('#registerform input[name="account"]');
    const code = $('#registerform input[name="code"]');
    const password = $('#registerform input[name="password"]');
    
    // 清除之前的提示
    layer.closeAll('tips');
    
    // 验证表单
    if (!account.val()) {
      layer.tips('请输入邮箱', account, {
        tips: [2, '#ff416c'],
        time: 3000
      });
      account.focus();
      return false;
    }
    
    if (!code.val()) {
      layer.tips('请输入验证码', code, {
        tips: [2, '#ff416c'],
        time: 3000
      });
      code.focus();
      return false;
    }
    
    if (!password.val()) {
      layer.tips('请设置密码', password, {
        tips: [2, '#ff416c'],
        time: 3000
      });
      password.focus();
      return false;
    }

    // 显示加载动画
    const loadingIndex = layer.load(1, {
      shade: [0.1, "#fff"],
    });

    $.ajax({
      type: "POST",
      dataType: "json",
      url: "/cross",
      data: $("#registerform").serialize(),
      success: function (data) {
        layer.close(loadingIndex);
        if (!data.error) {
          layer.msg("注册成功", { icon: 1 });
          setTimeout(() => {
            window.location.href = "/";
          }, 1500);
        } else {
          layer.msg(data.msg, { icon: 2 });
        }
      },
      error: function () {
        layer.close(loadingIndex);
        layer.msg("出错了请重试", { icon: 2 });
      },
    });
  });

  // 找回密码表单提交
  $("body").on("click", '#findpwdform button[type="submit"]', function () {
    const account = $('#findpwdform input[name="account"]');
    const code = $('#findpwdform input[name="code"]');
    const password = $('#findpwdform input[name="password"]');
    
    // 清除之前的提示
    layer.closeAll('tips');
    
    // 验证表单
    if (!account.val()) {
      layer.tips('请输入账号', account, {
        tips: [2, '#ff416c'],
        time: 3000
      });
      account.focus();
      return false;
    }
    
    if (!code.val()) {
      layer.tips('请输入验证码', code, {
        tips: [2, '#ff416c'],
        time: 3000
      });
      code.focus();
      return false;
    }
    
    if (!password.val()) {
      layer.tips('请设置新密码', password, {
        tips: [2, '#ff416c'],
        time: 3000
      });
      password.focus();
      return false;
    }

    // 显示加载动画
    const loadingIndex = layer.load(1, {
      shade: [0.1, "#fff"],
    });

    $.ajax({
      type: "POST",
      dataType: "json",
      url: "/cross",
      data: $("#findpwdform").serialize(),
      success: function (data) {
        layer.close(loadingIndex);
        if (!data.error) {
          layer.msg("密码重置成功", { icon: 1 });
          setTimeout(() => {
            window.location.href = "/";
          }, 1500);
        } else {
          layer.msg(data.msg, { icon: 2 });
        }
      },
      error: function () {
        layer.close(loadingIndex);
        layer.msg("出错了请重试", { icon: 2 });
      },
    });
  });

  // 登录表单提交
  $("body").on("click", '#loginform button[type="submit"]', function () {
    const account = $('#loginform input[name="account"]');
    const password = $('#loginform input[name="password"]');
    
    // 清除之前的提示
    layer.closeAll('tips');
    
    // 验证表单
    if (!account.val()) {
      layer.tips('请输入账号', account, {
        tips: [2, '#ff416c'],
        time: 3000
      });
      account.focus();
      return false;
    }
    
    if (!password.val()) {
      layer.tips('请输入密码', password, {
        tips: [2, '#ff416c'],
        time: 3000
      });
      password.focus();
      return false;
    }

    // 显示加载动画
    const loadingIndex = layer.load(1, {
      shade: [0.1, "#fff"],
    });

    $.ajax({
      type: "POST",
      dataType: "json",
      url: "/login",
      data: $("#loginform").serialize(),
      success: function (data) {
        layer.close(loadingIndex);
        if (!data.error) {
          layer.msg("登录成功", { icon: 1 });
          setTimeout(() => {
            window.location.href = "/";
          }, 1500);
        } else {
          layer.msg(data.msg, { icon: 2 });
        }
      },
      error: function () {
        layer.close(loadingIndex);
        layer.msg("出错了请重试", { icon: 2 });
      },
    });
  });

  // 发送验证码
  $("body").on("click", ".sendcode button", function () {
    var type = $(this).attr("type");
    var account = $("#" + type + "form input[name='account']");
    var captchaCode = $("#" + type + "form input[name='captcha_code']");
    var captchaToken = $("#" + type + "form input[name='captcha_token']");

    // 清除之前的提示
    layer.closeAll('tips');
    
    // 验证表单
    if (!account.val()) {
      layer.tips('请输入邮箱', account, {
        tips: [2, '#ff416c'],
        time: 3000
      });
      account.focus();
      return false;
    }

    if (!captchaCode.val()) {
      layer.tips('请输入图形验证码', captchaCode, {
        tips: [2, '#ff416c'],
        time: 3000
      });
      captchaCode.focus();
      return false;
    }

    if (!captchaToken.val()) {
      layer.msg('验证码已过期，请刷新验证码', { icon: 2 });
      loadCaptcha(type);
      return false;
    }

    // 显示加载动画
    const loadingIndex = layer.load(1, {
      shade: [0.1, "#fff"],
    });

    $.ajax({
      type: "POST",
      dataType: "json",
      url: "/cross",
      data: { 
        send_code: 1, 
        account: account.val(), 
        type: type,
        captcha_token: captchaToken.val(),
        captcha_code: captchaCode.val()
      },
      success: function (data) {
        layer.close(loadingIndex);
        if (!data.error) {
          layer.msg("验证码已发送", { icon: 1 });
          // 发送成功后刷新验证码
          //loadCaptcha(type);
          var count = 60;
          var countdown = setInterval(CountDown, 1000);

          function CountDown() {
            $("#" + type + "form .sendcode button").attr("disabled", true);
            $("#" + type + "form .sendcode button").text(count + "秒");
            if (count == 0) {
              $("#" + type + "form .sendcode button")
                .text("获取验证码")
                .removeAttr("disabled");
              clearInterval(countdown);
            }
            count--;
          }
        } else {
          layer.msg(data.msg, { icon: 2 });
          // 发送失败后也刷新验证码
          loadCaptcha(type);
        }
      },
      error: function () {
        layer.close(loadingIndex);
        layer.msg("出错了请重试", { icon: 2 });
      },
    });
  });

  // 移动版导航按钮功能
  $("#mobileLogin").on("click", function() {
    container.classList.remove("right-panel-active");
    $("#mobileLogin").addClass("pulse-effect");
    $("#mobileRegister").removeClass("pulse-effect");
    $("#mobileFindPwd").removeClass("pulse-effect").hide();
  });
  
  $("#mobileRegister").on("click", function() {
    container.classList.add("right-panel-active");
    document.getElementById("register").style.display = "block";
    document.getElementById("findpwd").style.display = "none";
    $("#mobileRegister").addClass("pulse-effect");
    $("#mobileLogin").removeClass("pulse-effect");
    $("#mobileFindPwd").removeClass("pulse-effect").hide();
  });
  
  $("#mobileFindPwd").on("click", function() {
    container.classList.add("right-panel-active");
    document.getElementById("register").style.display = "none";
    document.getElementById("findpwd").style.display = "block";
    $("#mobileFindPwd").addClass("pulse-effect");
    $("#mobileLogin").removeClass("pulse-effect");
    $("#mobileRegister").removeClass("pulse-effect");
  });
  
  // 点击忘记密码链接时，显示移动版找回密码按钮
  $("#findPwd").on("click", function() {
    $("#mobileFindPwd").show();
    $("#mobileFindPwd").addClass("pulse-effect");
    $("#mobileLogin").removeClass("pulse-effect");
    $("#mobileRegister").removeClass("pulse-effect");
  });
  
  // 检测是否是移动设备
  function isMobileDevice() {
    return (window.innerWidth <= 768);
  }
  
  // 根据设备类型调整UI
  function adjustForDevice() {
    if (isMobileDevice()) {
      $(".mobile-nav").show();
      // 默认选中登录按钮
      $("#mobileLogin").addClass("pulse-effect");
    } else {
      $(".mobile-nav").hide();
    }
  }
  
  // 页面加载和窗口大小改变时调整UI
  $(window).on("load resize", adjustForDevice);
  
  // 简化鼠标移动视差效果，保持微妙的科技感
  $(document).on('mousemove', function(e) {
    // 防抖动处理，减少频繁计算
    if (window.mouseMoveThrottle) return;
    window.mouseMoveThrottle = true;
    setTimeout(function() { window.mouseMoveThrottle = false; }, 20);
    
    // 获取鼠标位置
    const mouseX = e.pageX;
    const mouseY = e.pageY;
    
    // 计算移动百分比
    const moveX = (mouseX / $(window).width()) * 100;
    const moveY = (mouseY / $(window).height()) * 100;
    
    // 应用更微妙的边角装饰移动
    $('.corner-decoration').css({
      'transform': `translate(${(moveX - 50) / 25}px, ${(moveY - 50) / 25}px)`
    });
    
    // 应用网格移动 - 更加微妙
    $('.grid-lines').css({
      'background-position': `${moveX / 100}px ${moveY / 100}px`
    });
    
    // 给容器添加非常轻微的旋转效果
    $('.container').css({
      'transform': `perspective(1500px) rotateX(${(moveY - 50) / 200}deg) rotateY(${(50 - moveX) / 200}deg)`
    });
    
    // 添加鼠标跟随光效
    $('.mouse-glow').css({
      'left': mouseX + 'px',
      'top': mouseY + 'px',
      'opacity': 0.7
    });
    
    // 渐隐光效
    clearTimeout(window.mouseGlowTimer);
    window.mouseGlowTimer = setTimeout(function() {
      $('.mouse-glow').css('opacity', 0);
    }, 500);
  });
  
  // 添加表单元素的悬停效果
  $('.container').on('mouseenter', 'button, input, a', function() {
    $(this).addClass('hover-effect');
  }).on('mouseleave', 'button, input, a', function() {
    $(this).removeClass('hover-effect');
  });

  // 自动检测暗黑模式并应用相应样式
  function checkDarkMode() {
    if (
      window.matchMedia &&
      window.matchMedia("(prefers-color-scheme: dark)").matches
    ) {
      document.body.classList.add("dark-mode");
    } else {
      document.body.classList.remove("dark-mode");
    }
  }

  // 初始检查暗黑模式
  checkDarkMode();

  // 监听系统主题变化
  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", checkDarkMode);

  // 检测 URL 中的 redirect 参数
  function checkRedirect() {
    const urlParams = new URLSearchParams(window.location.search);
    const redirect = urlParams.get('redirect');
    
    if (redirect) {
      // 解析重定向URL并显示更具体的提示（如果可能）
      try {
        const decodedUrl = decodeURIComponent(redirect);
        // 如果是特定页面，可以显示更具体的提示
        if (decodedUrl.includes('filter')) {
          $('#login-tip-text').text('您需要登录后才能使用内容过滤功能');
          $('.login-tip').addClass('highlight-tip');
        } else if (decodedUrl.includes('favorite')) {
          $('#login-tip-text').text('您需要登录后才能使用收藏功能');
          $('.login-tip').addClass('highlight-tip');
        } else if (decodedUrl.includes('sponsors')) {
          $('#login-tip-text').text('您需要登录后才能使用广告发布和管理功能');
          $('.login-tip').addClass('highlight-tip');
        } else if (decodedUrl.includes('search')) {
          $('#login-tip-text').text('您需要登录后才能使用搜索功能');
          $('.login-tip').addClass('highlight-tip');
        }
      } catch (e) {
        console.error('URL 解析错误', e);
      }
    }
  }
  
  // 关闭提示条
  $('#close-tip').on('click', function() {
    $('.login-tip-container').slideUp(200);
  });
  
