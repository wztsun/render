<script type="text/javascript">

$(document).ready(function() {
	
	$.getData = function(t) {
	
			$.ajax({
		        url: 'https://itunes.apple.com/cn/rss/top'+t+'applications/limit=100/genre=25129/json',
		        type: 'GET',
		        dataType: 'json',
		        success: function(data) {
		            if((data.feed.hasOwnProperty('entry'))){
			            $.each(data.feed.entry,function(i,v){
				             $("#"+t+"_"+i).html('<div class="app-block"><a href="'+v['id'].label+'" target="_blank"><div class="app-icon"><img class="lazy" src="https://file.ipadown.com/tophub/assets/images/placeholder-lazyload.png" data-original="'+v['im:image'][2].label+'"></div></a><div class="app-info"><h4><a href="'+v['id'].label+'" target="_blank">'+v['im:name'].label+'</a></h4><p>'+v['im:artist'].label+'</p><p class="app-price">'+v['category'].attributes.label+' · '+(v['im:price'].label.match('获取|Get|入手|取得')?"免费":v['im:price'].label)+'</p></div></div>');
						});
						$("tr").show();
						$(".chart-grid").hide();
		            }
		            else{
						//加载失败
		            }
		            $(".lazy").lazyload();
		        }
		    });
	
	};
	
	$.getData("free");
	$.getData("paid");
	$.getData("grossing");
	
	// 处理订阅榜单和新app上榜通知按钮点击事件
	$('.subscribe-btn').click(function(e) {
		e.preventDefault();
		var listType = $(this).data('list');
		$(this).toggleClass('active');
		
		// 获取当前的参数
		var device = '';
		var store = 'cn';
		var cate = '25129';
		var subcate = '25180';
		
		// 这里可以添加订阅榜单的逻辑
		if ($(this).hasClass('active')) {
			// 订阅榜单
			alert('已订阅' + listType + '榜单，有新变化时将通知您');
			// 这里可以添加AJAX请求，将订阅信息发送到服务器
			// $.post('/api/subscribe', {list_type: listType, device: device, store: store, cate: cate, subcate: subcate});
		} else {
			// 取消订阅
			alert('已取消订阅' + listType + '榜单');
			// 这里可以添加AJAX请求，将取消订阅信息发送到服务器
			// $.post('/api/unsubscribe', {list_type: listType, device: device, store: store, cate: cate, subcate: subcate});
		}
	});
	
	$('.notify-btn').click(function(e) {
		e.preventDefault();
		var listType = $(this).data('list');
		$(this).toggleClass('active');
		
		// 获取当前的参数
		var device = '';
		var store = 'cn';
		var cate = '25129';
		var subcate = '25180';
		
		// 这里可以添加新app上榜通知的逻辑
		if ($(this).hasClass('active')) {
			// 开启新app上榜通知
			alert('已开启' + listType + '榜单新app上榜通知');
			// 这里可以添加AJAX请求，将通知设置发送到服务器
			// $.post('/api/notify', {list_type: listType, device: device, store: store, cate: cate, subcate: subcate});
		} else {
			// 关闭新app上榜通知
			alert('已关闭' + listType + '榜单新app上榜通知');
			// 这里可以添加AJAX请求，将取消通知设置发送到服务器
			// $.post('/api/unnotify', {list_type: listType, device: device, store: store, cate: cate, subcate: subcate});
		}
	});
    
    
    $('.charts-fliter-wrapper a.more').click(function(e){
		var isFold = parseInt($(this).attr("fold"));
		$(this).attr("fold",isFold==0?1:0);
		if(isFold==1){
			$(this).parent().find("a").show();
			$(this).text("折叠收起");
		}
		else{
			$(this).parent().find("a").each(function(i,e){
				if(i<15 || $(e).hasClass("selected") || $(e).hasClass("more")) $(e).show();
				else $(e).hide();
			});
			$(this).text("更多国家");
		}
		
	});

});


