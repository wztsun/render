		// 非会员用户只能查看当天数据
		if (!window.isVip && !dateInfo.isToday) {
			showVipTip();
			return;
		}
		
		// 更新导出按钮参数
		var exportParams = {
			module: "node",
			nodeid: window.nodeId,
			type: "snapshot",
			date: dateInfo.selectedDate
		};
		$('.snapshot-export').attr('export-params', JSON.stringify(exportParams));
		
		// 显示加载中
		$('.snapshot-loading').removeClass('hidden');
		$('.snapshot-hours').empty();
		$('.snapshot-empty').addClass('hidden');
		$('.snapshot-hours').removeClass('hidden');
		
		// 发送请求获取快照列表
		$.ajax({
			url: '/node-snapshot-list',
			type: 'POST',
			data: {
				nodeid: window.nodeId,
				date: dateInfo.selectedDate
			},
			dataType: 'json',
			success: function(res) {
				$('.snapshot-loading').addClass('hidden');
				
				if (res.error) {
				// 显示错误信息
				$('.snapshot-empty').removeClass('hidden');
				$('.snapshot-hours').addClass('hidden');
				$('.snapshot-loading').addClass('hidden');
				return;
			}
			
			// 现在我们知道 res.data.snapshots 是一个对象，其中键是小时，值是数组
			var data = res.data.snapshots || {};
			if (!data || Object.keys(data).length === 0) {
				// 没有快照数据
				$('.snapshot-empty').removeClass('hidden');
				$('.snapshot-hours').addClass('hidden');
				return;
			}
			
			// 数据已经是按小时分组的，直接使用
			var snapshotsByHour = data;
				// 渲染快照列表
				var hours = Object.keys(snapshotsByHour).sort(function(a, b) {
					return a - b;
				});
				
				// 按时间段分组
				var timeGroups = {
					'morning': { label: '凌晨', hours: [], icon: '&#xe604;' },
					'noon': { label: '上午', hours: [], icon: '&#xe7f2;' },
					'afternoon': { label: '下午', hours: [], icon: '&#xe7f3;' },
					'evening': { label: '晚上', hours: [], icon: '&#xe731;' }
				};
				
				// 将小时分到各个时间段
				hours.forEach(function(hour) {
					var hourInt = parseInt(hour);
					if (hourInt >= 0 && hourInt < 6) {
						timeGroups.morning.hours.push(hour);
					} else if (hourInt >= 6 && hourInt < 12) {
						timeGroups.noon.hours.push(hour);
					} else if (hourInt >= 12 && hourInt < 18) {
						timeGroups.afternoon.hours.push(hour);
					} else {
						timeGroups.evening.hours.push(hour);
					}
				});
				
				// 生成时间点HTML
				// 添加标题
			var timelineHtml = '<div class="snapshot-timeline">';
				
				// 遍历时间段
				for (var group in timeGroups) {
					var groupData = timeGroups[group];
					if (groupData.hours.length > 0) {
						// 添加时间段标题
						timelineHtml += '<div class="time-group-header"><i class="m-n">' + groupData.icon + '</i><span>' + groupData.label + '</span></div>';
						timelineHtml += '<div class="time-group">';
						
						// 按小时分组
						groupData.hours.sort(function(a, b) { return parseInt(a) - parseInt(b); }).forEach(function(hour) {							
							// 添加小时分组
							timelineHtml += '<div class="hour-group">';
							timelineHtml += '<div class="hour-label"><span>' + hour + ':00</span></div>';
							timelineHtml += '<div class="time-points">';
							
							// 添加快照时间点
							if (Array.isArray(snapshotsByHour[hour])) {
								snapshotsByHour[hour].forEach(function(snapshot) {
									var snapshotUniqueId = 'snapshot-' + hour + '-' + snapshot.time.replace(':', '');
									timelineHtml += '<div id="' + snapshotUniqueId + '" class="snapshot-item" data-id="' + snapshot.id + '" data-timestamp="' + snapshot.timestamp + '">';
									timelineHtml += '<span class="time-badge">' + snapshot.time + '</span>';
									timelineHtml += '</div>';
								});
							}
							
							timelineHtml += '</div>'; // time-points
							timelineHtml += '</div>'; // hour-group
						});
						
						timelineHtml += '</div>'; // time-group
					}
				}
				
				timelineHtml += '</div>'; // snapshot-timeline
				
				// 渲染到页面
				$('.snapshot-hours').html(timelineHtml);
				
				// 显示提示信息
				$('.snapshot-info').addClass('hidden');
			},
			error: function() {
				$('.snapshot-loading').addClass('hidden');
				$('.snapshot-empty').removeClass('hidden');
				$('.snapshot-hours').addClass('hidden');
				layer.msg('加载快照列表失败，请重试');
			}
		});
		
	}
	
