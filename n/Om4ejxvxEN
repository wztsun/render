	// 切换历史记录和榜单快照标签
	$('.time-machine-tabs .tab-sort-item').on('click', function() {
		var $this = $(this);
		if ($this.hasClass('active')) return;
		
		// 切换标签激活状态
		$('.time-machine-tabs .tab-sort-item').removeClass('active');
