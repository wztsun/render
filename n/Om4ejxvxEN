	function changeY(){
		var year=$('#year').text().replace(/[^0-9]/ig,"")
		var month=$('#month').text().replace(/[^0-9]/ig,"")
		var d = new Date(year, month, 0);
		var days=d.getDate();
		var dayArr=[];
		for(var i=1;i<=days;i++)
		{
			dayArr.push(i+'');
		}
		var last=parseInt(dayArr[dayArr.length-1]);
		//$('.slider-container').remove();	
		if($('.slider-container').length > 0 ){
			$('.slider').children().remove();
			$('.slider').html('<input type="hidden" value="" class="single-slider none">');
		}
		
		p = 1;//第一页
		isloading = 0;
		isend = 0;

		$('.single-slider').jRange({
		    from:1,
		    to:last,
		    step: 1,
		    scale: dayArr,
		    format: '%s',
		    width:$('.slider').outerWidth()-20,
		    showLabels: true,
		    snap: true,
		    onstatechange:function () {
				p = 1;
				isloading = 0;
				isend = 0;
				$(".filter-data").empty();
				$('.snapshot-hours').empty();
				$('.snapshot-back-btn').click();
				
				// 获取当前筛选日期
				var dateInfo = getCurrentFilterDate();
				
				// 更新导出按钮
				updateExportDate();
				
				// 非会员用户只能查看当天数据
				if (!window.isVip && !dateInfo.isToday) {
					showVipTip();
