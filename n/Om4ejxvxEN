			if ($('.filter-data').children().length > 0) {
				return ;
			}
			
			// 加载历史数据
			p = 1; // 重置页码
			$(".filter-data").empty(); // 清空现有数据
			loadDataByDate();
		} else {
			// 切换到榜单快照标签
			$('.history-content').addClass('hidden');
