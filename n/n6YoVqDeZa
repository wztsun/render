/**
 * 初始化导航菜单
 */
function initNavigationMenu() {
    // 获取菜单容器
    var $menuContainer = $('.daily-menu');
    
    // 清空现有菜单项（保留第一个"最新"和第二个"历史快照"）
    var $menuList = $menuContainer.find('ul');
    var $firstItems = $menuList.find('li').slice(0, 2).clone();
    $menuList.empty().append($firstItems);
    
    // 第一个菜单项点击事件（最新）
    $menuList.find('li').eq(0).click(function() {
        $('html, body').animate({
            scrollTop: $('.tab-sort-item#latest').offset().top - 84
        }, 500);
        $menuContainer.hide();
    });
    
    // 第二个菜单项点击事件（历史快照）
    $menuList.find('li').eq(1).click(function() {
        $('html, body').animate({
            scrollTop: $('.cc-dc-ec h2:contains("时光机")').offset().top - 84
        }, 500);
        $menuContainer.hide();
    });
    
    // 获取所有标题元素并添加到菜单
    $('.header span span.before').each(function(index) {
        var $header = $(this).parent();
        var headerText = $header.text().replace('【', '').replace('】', '');
        
        // 创建菜单项
        var $menuItem = $('<li></li>').text(headerText);
        
        // 点击菜单项时滚动到对应标题，考虑64px的固定导航高度
        $menuItem.click(function() {
            $('html, body').animate({
                scrollTop: $header.parent().offset().top - 84 // 64px导航高度 + 20px额外偏移
            }, 500);
            $menuContainer.hide(); // 点击后隐藏菜单
        });
        
        $menuList.append($menuItem);
    });
    
    // 添加关闭按钮事件
    $menuContainer.find('.close').click(function() {
        $menuContainer.hide();
    });
    
    // 监听滚动事件，控制菜单显示和隐藏
    var windowHeight = $(window).height();
    var showMenuThreshold = windowHeight; // 滚动一屏后显示
    
    $(window).scroll(function() {
        var scrollTop = $(window).scrollTop();
        
        // 滚动超过一屏显示菜单，回到顶部隐藏菜单
        if (scrollTop > showMenuThreshold) {
            $menuContainer.fadeIn(300);
        } else {
            $menuContainer.fadeOut(300);
        }
    });
}

// 页面加载完成后初始化导航菜单
$(document).ready(function() {
    initNavigationMenu();
});
