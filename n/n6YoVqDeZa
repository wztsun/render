					<button id="submit-search" class="btn btn-primary" style="padding: 6px 12px; background: #4e6ef2; color: #fff; border: none; border-radius: 4px;">搜索</button>
				</div>
			</div>
		`,
		width: '340px',
		multi: false,
		closeable: false,
		style: (Cookies.get('darkmode') ? 'inverse' : ''),
		padding: false,
		backdrop: false,
