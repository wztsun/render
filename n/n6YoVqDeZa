							$(document).on('click', '#back-to-latest', function() {
								$('.stt').click();
							});
						}
					} else {
						// 有内容时正常显示数据
						// 隐藏提示信息区域
						$(".p-s").addClass("hidden");
						// 确保表格显示
						$(".history-content").removeClass("hidden");
						var s = '';
						$.each(data.data.items, function(i, v) {
							var index = i + 1;
							s += '<tr><td align="center" width="80px">' + v.time + '</td>';
														s += '<td><a href="' + v.url + '" target="_blank" rel="nofollow" itemid="' + v.ID + '">' + v.title + '</a></td><td class="ws">' + v.extra + '</td><td align="right"><a href="' + v.url + '" title="查看详细" target="_blank" rel="nofollow" itemid="' + v.ID + '"><i class="m-n">&#xe652;</i></a></td></tr>';
						});
						$(".filter-data").append(s);						
					}
					
					if( data.data.items.length <= 1 ) {
						$(".infinite-scroll-last").removeClass('hidden');
						isend = 1;
					}
					else {
						$(".infinite-scroll-loadmore").removeClass('hidden');
					}
					p++;
				}
				else {
					if(data.msg.match("会员")) {
						$("#to-pay").removeClass("hidden");
					}
					else {
						layer.msg(data.msg);
					}
				}
				isloading = 0;
			},
			error: function () {
				isloading = 0;
				layer.msg('加载失败，请重试');
			}
		});		
	}
	
	// 初始化时更新导出按钮
	updateExportDate();

	
	// 初始化节点内搜索弹窗
