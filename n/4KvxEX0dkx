				}
				
				// 渲染榜单快照内容
				var tableHtml = '';
				
				// 复用与最新榜单相同的模板逻辑
				items.forEach(function(item, index) {
					var rank = index + 1;
					var extra = item.extra || '';
					
					// 辅助函数，用于检查值是否为空
					function empty(val) {
						return val === undefined || val === null || val === '';
					}
					
					// 确保item.extra存在
					if (!item.extra) item.extra = '';
					
					// 使用与最新榜单相同的模板类型
					switch(window.nodeTemplate) {
						case '0': // 默认排版（左边title，右边显示extra）
							tableHtml += '<tr>' +
								'<td align="center">' + rank + '.</td>' +
