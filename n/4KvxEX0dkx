							'</tr>';
							break;
						
						case '1': // 4:3 标准长方形 文章缩略图
							var desc1 = !empty(item.extra) ? item.extra : item.description;
							tableHtml += '<tr>' +
								'<td align="center">' + rank + '.</td>' +
								'<td class="al" align="center"><img src="' + (item.thumbnail || '') + '" onerror="this.onerror=null;this.src="https://file.ipadown.com/tophub/assets/images/placeholder-lazyload.png"" width="100" height="64" style="object-fit: cover;" referrerPolicy="no-referrer" /></td>' +
								'<td class="al">' +
									'<div><a href="' + item.url + '" target="_blank" rel="nofollow" itemid="' + item.ID + '">' + item.title + '</a></div>' +
									'<div class="item-desc">' + desc1 + '</div>' +
								'</td>' +
								'<td align="right"><a href="' + item.url + '" title="查看详细" target="_blank" rel="nofollow" itemid="' + item.ID + '"><i class="m-n">&#xe652;</i></a></td>' +
							'</tr>';
							break;
						
						case '2': // 1:1 标准正方形 文章缩略图
							var desc2 = !empty(item.description) ? item.description : item.extra;
							tableHtml += '<tr>' +
								'<td align="center">' + rank + '.</td>' +
								'<td class="al" align="center"><img src="' + (item.thumbnail || '') + '" onerror="this.onerror=null;this.src=\"https://file.ipadown.com/tophub/assets/images/placeholder-lazyload.png\"" width="80" height="80" style="object-fit: cover;" referrerPolicy="no-referrer" /></td>' +
								'<td class="al">' +
									'<div><a href="' + item.url + '" target="_blank" rel="nofollow" itemid="' + item.ID + '">' + item.title + '</a></div>' +
									'<div class="item-desc">' + desc2 + '</div>' +
								'</td>' +
								'<td align="right"><a href="' + item.url + '" title="查看详细" target="_blank" rel="nofollow" itemid="' + item.ID + '"><i class="m-n">&#xe652;</i></a></td>' +
							'</tr>';
							break;
						
						case '3': // 1:1 圆角正方形 app图标
							var desc3 = !empty(item.description) ? item.description : item.extra;
							tableHtml += '<tr>' +
								'<td align="center">' + rank + '.</td>' +
								'<td class="al" align="center"><img src="' + (item.thumbnail || '') + '" onerror="this.onerror=null;this.src=\"https://file.ipadown.com/tophub/assets/images/placeholder-lazyload.png\"" width="80" height="80" style="border-radius: 15px; object-fit: cover;" referrerPolicy="no-referrer" /></td>' +
								'<td class="al">' +
									'<div><a href="' + item.url + '" target="_blank" rel="nofollow" itemid="' + item.ID + '">' + item.title + '</a></div>' +
									'<div class="item-desc">' + desc3 + '</div>' +
								'</td>' +
								'<td align="right"><a href="' + item.url + '" title="查看详细" target="_blank" rel="nofollow" itemid="' + item.ID + '"><i class="m-n">&#xe652;</i></a></td>' +
							'</tr>';
							break;
						
						case '4': // 160:220 影视海报,小说封面,短视频
							tableHtml += '<tr>' +
								'<td align="center">' + rank + '.</td>' +
								'<td class="al" align="center"><img src="' + (item.thumbnail || '') + '" onerror="this.onerror=null;this.src=\"https://file.ipadown.com/tophub/assets/images/placeholder-lazyload.png\"" width="80" height="110" style="object-fit: cover;" referrerPolicy="no-referrer" /></td>' +
								'<td class="al">' +
									'<div><a href="' + item.url + '" target="_blank" rel="nofollow" itemid="' + item.ID + '">' + item.title + '</a></div>' +
									'<div class="item-desc">' + (item.description || '') + '</div>' +
									'<div class="item-extra">' + (item.extra || '') + '</div>' +
								'</td>' +
								'<td align="right"><a href="' + item.url + '" title="查看详细" target="_blank" rel="nofollow" itemid="' + item.ID + '"><i class="m-n">&#xe652;</i></a></td>' +
							'</tr>';
							break;
						
						case '5': // 1:1 购物大图
							var desc5 = !empty(item.description) ? item.description : item.extra;
							tableHtml += '<tr>' +
								'<td align="center">' + rank + '.</td>' +
								'<td class="al" align="center"><img src="' + (item.thumbnail || '') + '" onerror="this.onerror=null;this.src=\"https://file.ipadown.com/tophub/assets/images/placeholder-lazyload.png\"" width="100" height="100" style="object-fit: cover;" referrerPolicy="no-referrer" /></td>' +
								'<td class="al">' +
									'<div><a href="' + item.url + '" target="_blank" rel="nofollow" itemid="' + item.ID + '">' + item.title + '</a></div>' +
