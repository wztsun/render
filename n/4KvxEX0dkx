// 获取当前筛选日期
function getCurrentFilterDate() {
	// 获取年份
	var year = $('#year').text().replace(/[^0-9]/ig,"");
	
	// 获取月份并确保两位数格式
	var month = $('#month').text().replace(/[^0-9]/ig,"");
	month = month.padStart(2, '0'); // 确保月份是两位数
	
	// 获取日期并确保两位数格式
	var day = $('.single-slider').val().replace(/[^0-9]/ig,"");
	day = day.padStart(2, '0'); // 确保日期是两位数
	
	// 获取当前日期
	var today = new Date().getFullYear() + "-" + (new Date().getMonth() + 1).toString().padStart(2, '0') + "-" + new Date().getDate().toString().padStart(2, '0');
	
	// 构建选中的日期
	var selectedDate = year + "-" + month + "-" + day;
	
	// 返回日期信息对象
	return {
		year: year,
		month: month,
		day: day,
		selectedDate: selectedDate,
		today: today,
		isToday: (selectedDate === today)
	};
}

