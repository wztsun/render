	// 加载快照内容
	// 渲染快照内容
	function loadSnapshotItems(snapshotId) {
		if (!snapshotId) {
			$('.snapshot-data').html('<tr><td colspan="2" class="no-items">无效的快照ID</td></tr>');
			return;
		}
		
		// 显示加载中
		$('.snapshot-content-loading').removeClass('hidden');
		$('.snapshot-data').empty();
		
		// 发送请求获取快照内容
		$.ajax({
			url: '/node-snapshot-items',
			type: 'POST',
			data: {
				snapshot_id: snapshotId
			},
			dataType: 'json',
			success: function(res) {
				$('.snapshot-content-loading').addClass('hidden');
				
				// 检查错误情况
				if (res.error) {
					$('.snapshot-data').html('<tr><td colspan="2" class="no-items">加载失败</td></tr>');
					return;
				}

				$('.snapshot-time').text('快照时间: ' + res.data.snapshot_time);
				
				// 检查数据是否存在
				if (!res.data) {
					$('.snapshot-data').html('<tr><td colspan="2" class="no-items">暂无快照数据</td></tr>');
					return;
				}
				
				// 先检查items属性
				var items = [];
				if (res.data.items && Array.isArray(res.data.items)) {
					items = res.data.items;
				} else if (Array.isArray(res.data)) {
					// 如果数据直接就是数组
					items = res.data;
				}
				
				if (items.length === 0) {
					$('.snapshot-data').html('<tr><td colspan="2" class="no-items">暂无快照数据</td></tr>');
