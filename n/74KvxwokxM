		changeY();
		updateExportDate(); // 更新导出按钮文本
	});

	function changeY(){
		var year=$('#year').text().replace(/[^0-9]/ig,"")
		var month=$('#month').text().replace(/[^0-9]/ig,"")
		var d = new Date(year, month, 0);
		var days=d.getDate();
		var dayArr=[];
		for(var i=1;i<=days;i++)
		{
			dayArr.push(i+'');
		}
		var last=parseInt(dayArr[dayArr.length-1]);
		//$('.slider-container').remove();	
		if($('.slider-container').length > 0 ){
			$('.slider').children().remove();
			$('.slider').html('<input type="hidden" value="" class="single-slider none">');
		}
		
		p = 1;//第一页
		isloading = 0;
		isend = 0;

		$('.single-slider').jRange({
		    from:1,
		    to:last,
		    step: 1,
		    scale: dayArr,
		    format: '%s',
		    width:$('.slider').outerWidth()-20,
		    showLabels: true,
		    snap: true,
		    onstatechange:function () {
				p = 1;
				isloading = 0;
				isend = 0;
				$(".filter-data").empty();
				$('.snapshot-hours').empty();
				$('.snapshot-back-btn').click();
				
				// 获取当前筛选日期
				var dateInfo = getCurrentFilterDate();
				
				// 更新导出按钮
				updateExportDate();
				
				// 非会员用户只能查看当天数据
				if (!window.isVip && !dateInfo.isToday) {
					showVipTip();
					return;
				}
					
				// 根据当前激活的标签加载相应内容
				if ($('#history-tab').hasClass('active')) {
					loadDataByDate();
				} else {
					loadSnapshotList();
				}
            }
		});
	}

	// 显示会员提醒
	function showVipTip(){
		// 隐藏所有内容区域
		$(".p-s").addClass("hidden");
		$('.history-content').addClass("hidden");
		$('.snapshot-content').addClass("hidden");
		// 显示会员提示
		$("#to-pay").removeClass("hidden");
	}
	
	function loadDataByDate(){
		// 获取当前筛选日期
		var dateInfo = getCurrentFilterDate();
		
		// 非会员用户只能查看当天数据
		if(!window.isVip && !dateInfo.isToday) {
			showVipTip();
			return;
		}
		
		if(isloading || isend){
			return ;
		}

		$.ajax({
			method: "POST",
		    url: "/node-items-by-date",
		    data: {
		      p: p,
		      date : dateInfo.selectedDate,
		      nodeid : window.nodeId
		    },
		    dataType: 'json',
		    beforeSend: function () {
				isloading = 1;
				$(".infinite-scroll-request").removeClass('hidden');
				$(".infinite-scroll-last").addClass('hidden');
				$(".infinite-scroll-error").addClass('hidden');
				$(".infinite-scroll-loadmore").addClass('hidden');

				if(p == 1){
					$(".p-s").addClass("hidden");
					$(".history-content").addClass("hidden");
				}
		    },
		    success: function ( data ) {
				$(".infinite-scroll-request").addClass('hidden');
				
				if(!data.error){
					// 检查数据是否为空
					if(data.data.items.length === 0) {
						if(p == 1){
							// 向上查找最近的 rank-all-item 并添加 hidden 类
							$(".history-content").addClass("hidden");
							// 显示提示信息区域
							$("#no-data").removeClass("hidden");
							// 添加返回最新榜单的点击事件
							$(document).on('click', '#back-to-latest', function() {
								$('.stt').click();
							});
						}
					} else {
						// 有内容时正常显示数据
						// 隐藏提示信息区域
						$(".p-s").addClass("hidden");
						// 确保表格显示
						$(".history-content").removeClass("hidden");
						var s = '';
						$.each(data.data.items, function(i, v) {
							var index = i + 1;
							s += '<tr><td align="center" width="80px">' + v.time + '</td>';
														s += '<td><a href="' + v.url + '" target="_blank" rel="nofollow" itemid="' + v.ID + '">' + v.title + '</a></td><td class="ws">' + v.extra + '</td><td align="right"><a href="' + v.url + '" title="查看详细" target="_blank" rel="nofollow" itemid="' + v.ID + '"><i class="m-n">&#xe652;</i></a></td></tr>';
						});
						$(".filter-data").append(s);						
					}
					
					if( data.data.items.length <= 1 ) {
						$(".infinite-scroll-last").removeClass('hidden');
						isend = 1;
					}
					else {
						$(".infinite-scroll-loadmore").removeClass('hidden');
					}
					p++;
				}
				else {
					if(data.msg.match("会员")) {
						$("#to-pay").removeClass("hidden");
					}
					else {
						layer.msg(data.msg);
					}
				}
				isloading = 0;
			},
			error: function () {
				isloading = 0;
				layer.msg('加载失败，请重试');
			}
		});		
	}
	
	// 初始化时更新导出按钮
	updateExportDate();

	
	// 初始化节点内搜索弹窗
	$('#search-in-node').webuiPopover({
		trigger: 'click',
		title: false,
		content: `
