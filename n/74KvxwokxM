				'export-params': JSON.stringify({module: 'node', nodeid: window.nodeId, type: 'history', date: dateStr})
			});
			
			// 更新按钮文本
			$('#export-date-text').text('导出 ' + dateStr + ' 上榜数据');
		}
	}

	
	$('.dropdown-toggle').click(function(){
		$(this).parent().toggleClass("open");
	});
	
	// 点击页面空白区域关闭dropdown
	$(document).click(function(e){
		if(!$(e.target).closest('.dropdown-menu').length && !$(e.target).hasClass('dropdown-toggle') && !$(e.target).parent().hasClass('dropdown-toggle')){
			$('.dropdown-menu').parent().removeClass("open");
