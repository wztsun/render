                $(document).ready(function() {
                    $(document).keydown(function(e) {
                        var currentPage = 1;
                        var totalPages = 41;
                        var baseUrl = "?&";
        
                        if (e.which == 37) { // Left arrow key
                            if (currentPage > 1) {
                                window.location.href = baseUrl + 'p=' + (currentPage - 1);
                            }
                        } else if (e.which == 39) { // Right arrow key
                            if (currentPage < totalPages) {
                                window.location.href = baseUrl + 'p=' + (currentPage + 1);
                            }
                        }
                    });
                });
                </script></div>

