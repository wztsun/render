        $(".I-K-L").focus();
    });
    
    // 点击搜索框以外的区域或按ESC键时取消搜索
    $(document).click(function(event) {
        if (!$(event.target).closest('#search-button, .I-J').length) {
            $(".kb-lb-ib-c").show();
            $(".I-J").hide();
        }
    });
    
    $(document).keyup(function(e) {
        if (e.key === "Escape") {
            $(".kb-lb-ib-c").show();
            $(".I-J").hide();
        }
    });
    
    // 阻止点击搜索框时触发document的click事件
    $(".I-J").click(function(event) {
        event.stopPropagation();
    });
});
