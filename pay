			'width': itemWidth + '%',
			'min-width': Math.min(150, 600 / itemCount) + 'px'
		});
		
		// 调整支付对话框中的会员方案选项宽度
		var selectBoxWidth = $('.pay-dialog .inner .buy-win .select-box').width();
		// 计算每个选项的最小和最大宽度
		var minWidth = Math.max(80, (selectBoxWidth - (itemCount * 8)) / (itemCount + 1));
		var maxWidth = Math.min(120, (selectBoxWidth - (itemCount * 8)) / itemCount);
		$('.pay-dialog .inner .buy-win .select-box li').css({
			'min-width': minWidth + 'px',
			'max-width': maxWidth + 'px'
		});
	}
	
	// 处理商品选择
	$('.select-box li').click(function() {
		$('.select-box li').removeClass('active');
		$(this).addClass('active');
		
		// 更新价格显示
		var price = $(this).attr('price');
		var org_price = $(this).attr('org_price');
		var pid = $(this).attr('pid');
		var tip = $(this).attr('tip');
		
		// 更新显示价格
		$('#selected-price').text(price);
		$('#selected-org-price').text(org_price);
		$('#qrcode-price').text(price);
		
		// 计算每日价格（如果是终身会员则不显示）
		var isLifetime = $(this).attr('vip_days') > 2000;
		if(isLifetime) {
			$('#daily-price').text('一次付费，终身享用，最具性价比');
		} else {
			var days = $(this).attr('vip_days');
			var dailyPrice = (price / days).toFixed(2);
			$('#daily-price').text(tip + '，平均每天仅需 ' + dailyPrice + ' 元');
		}
	});
	// 倒计时功能 - 基于3天周期的倒计时
	// 获取或设置结束时间
	function getOrSetEndTime() {
		// 尝试从 cookie 中获取结束时间
		var savedEndTime = Cookies.get('promotion_end_time');
		
		// 如果 cookie 中有结束时间，则使用它
		if (savedEndTime) {
			return new Date(parseInt(savedEndTime));
		}
		
		// 如果没有，则创建一个新的结束时间（当前时间 + 1天）
		var now = new Date();
		var newEndTime = new Date(now);
		newEndTime.setDate(newEndTime.getDate() + 1); // 设置为1天后
		
		// 将结束时间保存到 cookie，过期时间设置为2天
		Cookies.set('promotion_end_time', newEndTime.getTime(), { expires: 2 });
		
		return newEndTime;
	}
	
	// 检查倒计时是否已经结束，如果结束则重新开始一个新的周期
	function checkAndResetCountdown() {
		var savedEndTime = Cookies.get('promotion_end_time');
		if (savedEndTime) {
			var endTimeDate = new Date(parseInt(savedEndTime));
			var now = new Date();
			
			// 如果当前时间已经超过结束时间，则重新设置一个新的结束时间
			if (now >= endTimeDate) {
				// 删除旧的 cookie
				Cookies.remove('promotion_end_time');
				// 重新获取新的结束时间
				return getOrSetEndTime();
			}
		}
		return null; // 不需要重置
	}
	
	// 获取倒计时的结束时间
	var endTime = getOrSetEndTime();
	
	// 定时检查是否需要重置倒计时
	setInterval(function() {
		var newEndTime = checkAndResetCountdown();
		if (newEndTime) {
			endTime = newEndTime;
		}
	}, 60000); // 每分钟检查一次
	
	function updateCountdown() {
		try {
			// 获取当前时间
			var now = new Date();
			
			// 计算剩余时间（毫秒）
			var timeLeft = endTime - now;
			
			// 如果倒计时结束，显示全部为0
			if (timeLeft <= 0) {
				timeLeft = 0;
				// 检查是否需要重置倒计时
				var newEndTime = checkAndResetCountdown();
				if (newEndTime) {
					endTime = newEndTime;
					timeLeft = endTime - now;
				}
			}
			
			// 计算天、小时、分钟和秒数
			var days = Math.floor(timeLeft / (1000 * 60 * 60 * 24));
			var hours = Math.floor((timeLeft % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
			var minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
			var seconds = Math.floor((timeLeft % (1000 * 60)) / 1000);
			
			// 将天数加到小时中
			hours = hours + (days * 24);
			
			// 更新显示
			var hoursElement = document.getElementById('countdown-hours');
			var minutesElement = document.getElementById('countdown-minutes');
			var secondsElement = document.getElementById('countdown-seconds');
			
			if (hoursElement && minutesElement && secondsElement) {
				hoursElement.textContent = hours < 10 ? '0' + hours : hours;
				minutesElement.textContent = minutes < 10 ? '0' + minutes : minutes;
				secondsElement.textContent = seconds < 10 ? '0' + seconds : seconds;
			}
		} catch (error) {
			console.error('倒计时出错：', error);
		}
	}
	
	// 初始化倒计时
	updateCountdown();
	// 每秒更新一次
	setInterval(updateCountdown, 1000);
	
	// FAQ交互功能
	$('.faq-question').on('click', function() {
		var $answer = $(this).next('.faq-answer');
		var $icon = $(this).find('i');
		
		// 切换当前问题的展开/收起状态
		if ($answer.hasClass('show')) {
			$answer.removeClass('show');
			$(this).removeClass('active');
		} else {
			$answer.addClass('show');
			$(this).addClass('active');
		}
	});

	$('body').on('click', ".green-model-btn", function (e){
		$("#pay-dialog .pay-dialog").removeClass("mpa-hide");

	});
	
	$('body').on('click', ".close", function (e){
		$("#pay-dialog .pay-dialog").addClass("mpa-hide");
		$(".qr-win").addClass("mpa-hide");
		$(".buy-win").not(".qr-win").removeClass("mpa-hide");
		$(".introduce").removeClass("mpa-hide");
	});
	
	$('body').on('click', '.select-box li', function (){
		
		var tabs = $(this).parent().find("li");
		var index = $.inArray(this,tabs); 
		tabs.removeClass("active").eq(index).addClass("active");
		
		$(".money2").find("b").text($(this).attr("price"));
		$(".money2").find("s").text('原价 ' + $(this).attr("org_price") + ' 元');
	
	});
	
	$('body').on('click', '.retry-btn', function (){
		$(".qrcode .error-msg, .qrcode .retry-btn").remove();
		$('.btn-pay').click();
	});
	
	// 取消支付按钮点击事件
	$('body').on('click', '.pay-cancel-btn', function (){
		$(".qr-win").addClass("mpa-hide");
		$(".buy-win").not(".qr-win").removeClass("mpa-hide");
		$(".introduce").removeClass("mpa-hide");
	});
	
	// 支付成功按钮点击事件
	$('body').on('click', '.pay-success-btn', function (){
		var tradeSn = $(".qr-win").attr("data-trade-sn");
		if (!tradeSn) {
			alert("订单信息不存在，请重新发起支付");
			return;
		}
		
		// 显示查询中提示
		$(this).text("查询中...").prop("disabled", true).css("opacity", "0.7");
		
		// 调用查询订单 API
		$.ajax({
		  url: '/pay/query',
		  type: 'GET',
		  data: {
			"trade_sn" : tradeSn
		  },
		  success: function() {
			// 显示支付成功提示
			alert("支付成功，即将刷新页面");
			window.location.reload();
		  },
		  error: function() {
			alert("查询订单失败，请稍后再试或联系客服");
			$('.pay-success-btn').text("支付成功").prop("disabled", false).css("opacity", "1");
		  }
		});
	});
	
	$('body').on('click', '.btn-pay', function (){
		var $select = $(".select-box li.active");
		var $ptype = $(".pay-type .type.active");
		
		// 设置支付类型和价格
		$(".ptype").text($ptype.attr("tname"));
		$("#qrcode-price").text($select.attr("price"));
		
		// 显示加载提示
		$(".qrcode img").hide();
		$(".qrcode").append('<div class="loading-tip" style="text-align:center;padding:20px;"><p>正在生成支付二维码，请稍候...</p></div>');
		
		// 显示二维码区域，隐藏购买区域
		$(".qr-win").removeClass("mpa-hide");
		$(".buy-win").not(".qr-win").addClass("mpa-hide");
		$(".introduce").addClass("mpa-hide");
		
		// 调用支付 API 获取支付链接
		$.ajax({
		  url: '/pay/prepare',
		  type: 'GET',
		  data: {
			  pid : $select.attr("pid"),
			  channel_id : $ptype.attr("channel_id")
		  },
		  success: function(data) {
			if(!data.error){
			  // 更新二维码图片
			  $(".qrcode .loading-tip").remove();
			  $(".qrcode img").attr('src', 'https://xorpay.com/qr?data='+data.data.pay_link).show();
			  
			  // 存储订单号，用于后续查询
			  $(".qr-win").attr("data-trade-sn", data.data.trade_sn);
			}
			else {
			  // 显示错误信息
			  $(".qrcode img").hide();
			  $(".qrcode .loading-tip").remove();
			  $(".qrcode").append('<p class="error-msg" style="color:red;">获取支付二维码失败：' + data.msg + '</p>');
			  
			  // 添加重试按钮
			  $(".qrcode").append('<button class="retry-btn" style="margin-top:10px;padding:5px 15px;background:#20bf5c;color:#fff;border:none;border-radius:4px;cursor:pointer;">重试</button>');
			}
		  },
		  error: function(e){
			  $(".qrcode img").hide();
			  $(".qrcode .loading-tip").remove();
			  $(".qrcode").append('<p class="error-msg" style="color:red;">服务器响应错误，请加客服处理，谢谢！微信：ieliwb2</p>');
			  
			  // 添加重试按钮
			  $(".qrcode").append('<button class="retry-btn" style="margin-top:10px;padding:5px 15px;background:#20bf5c;color:#fff;border:none;border-radius:4px;cursor:pointer;">重试</button>');
		  }
		});
	});
		
	$('body').on('click', '.pay-type .type', function (){
		
		var tabs = $(this).parent().find(".type");
		var index = $.inArray(this,tabs); 
		tabs.removeClass("active").eq(index).addClass("active");
		
	});
	

	
});	
