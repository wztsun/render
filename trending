<script type="text/javascript">
	$(document).ready(function() {
	    // 从 DOM 数据属性获取参数
	    var $trendingResults = $('#trending-results');
	    var category = $trendingResults.data('category');
	    var tag = $trendingResults.data('tag');
	    var currentPage = $trendingResults.data('page');
	    var trendingUrl = $trendingResults.data('url');
	    
	    // 加载热文库结果
	    loadTrendingResults(trendingUrl);
	    
	    // JSONP 请求热文库结果
	    function loadTrendingResults(url) {
	        $('#trending-results').html('<div class="trending-result-loading"><div class="loading"><div></div><div></div><div></div><div></div></div><p>🚀 正在召唤小宇宙，请稍等~</p></div>');
	        
	        $.ajax({
	            url: url,
	            dataType: 'jsonp',
	            jsonpCallback: 'trendingCallback',
	            success: function(data) {
	                handleTrendingResults(data);
	            },
	            error: function() {
	                $('#trending-results').html('<div class="c-d c-d-e"><div class="p-s"><div class="p-i"><div class="m-n">&#xe69e;</div></div><div class="p-t">加载失败</div><div class="p-d">加载热文库结果失败，请刷新页面重试。</div></div></div>');
	            }
	        });
	    }
	    
	    // 处理热文库结果
	    function handleTrendingResults(data) {
	        // 清空结果容器
	        $('#trending-results').empty();
	        
	        // 如果没有结果
	        if (!data.items || data.items.length === 0) {
	            $('#trending-results').html('<div class="c-d c-d-e"><div class="p-s"><div class="p-i"><div class="m-n">&#xe69e;</div></div><div class="p-t">暂无数据</div><div class="p-d">没有找到相关结果。</div></div></div>');
	            return;
	        }
	        
	        // 渲染热文库结果
	        var resultHtml = '<div class="f-t-l"><div class="jc item">';
	        
	        $.each(data.items, function(index, item) {
	            // 根据不同平台可能需要不同的展示方式
	            if (category === 'wxmp' || category === 'bilibili') {
	                // 微信公众号文章样式
	                resultHtml += `
	                <div class="jc-a">
	                    <a href="${item.url}" target="_blank" rel="nofollow">
	                        ${item.cover ? `<div class="jc-a-img"><img src="${item.cover}" alt="${item.title}" referrerPolicy="no-referrer"></div>` : ''}
	                        <div class="jc-a-content">
	                            <div class="jc-a-t">${item.title}</div>
	                            <div class="jc-a-m">
	                                <div class="jc-a-mp-info">
	                                    ${item.mp_icon ? `<img src="${item.mp_icon}" class="jc-a-mp-icon" alt="${item.mp_name}" referrerPolicy="no-referrer">` : ''}
	                                    <span class="jc-a-m-n">${item.mp_name}</span>
	                                </div>
	                                <div class="jc-a-stats">
	                                    <span class="jc-a-m-t">${new Date(item.created_at * 1000).toLocaleDateString()}</span>
	                                    <span class="jc-a-m-read"><i class="m-n">&#xe6b4;</i>${item.read_count > 100000 ? '10万+' : item.read_count}</span>
	                                    <span class="jc-a-m-like"><i class="m-n">&#xe64a;</i>${item.like_count}</span>
	                                    ${item.read_count > 10000 ? '<span class="jc-a-tag hot">热</span>' : ''}
	                                    ${item.is_hits ? '<span class="jc-a-tag hits">爆</span>' : ''}
	                                </div>
	                            </div>
	                        </div>
	                    </a>
	                </div>`;
	            } else if (category === 'douyin' || category === 'wxsph') {
	                // 抖音视频样式
	                resultHtml += `
	                <div class="jc-a jc-douyin">
	                    <a href="${item.url}" target="_blank" rel="nofollow">
	                        <div class="jc-douyin-img"><img src="${item.cover || item.thumbnail}" alt="${item.title}" referrerPolicy="no-referrer"></div>
	                        <div class="jc-douyin-content">
	                            <div class="jc-a-t">${item.title}</div>
	                            <div class="jc-a-m">
	                                <div class="jc-a-mp-info">
	                                    ${item.mp_icon1 ? `<img src="${item.mp_icon}" class="jc-a-mp-icon" alt="${item.mp_name}" referrerPolicy="no-referrer">` : ''}
	                                    <span class="jc-a-m-n">${item.mp_name || item.author}</span>
	                                </div>
	                                <div class="jc-a-stats">
	                                    <span class="jc-a-m-t">${item.created_at ? new Date(item.created_at * 1000).toLocaleDateString() : item.time}</span>
	                                    <span class="jc-a-m-read"><i class="m-n">&#xe6b4;</i>${item.read_count || item.views}</span>
	                                    ${item.like_count ? `<span class="jc-a-m-like"><i class="m-n">&#xe64a;</i>${item.like_count}</span>` : ''}
	                                    ${item.read_count > 10000 || (item.views > 10000) ? '<span class="jc-a-tag hot">热</span>' : ''}
	                                    ${item.is_hits ? '<span class="jc-a-tag hits">爆</span>' : ''}
	                                </div>
	                            </div>
	                        </div>
	                    </a>
	                </div>`;
	            }
	        });
	        
	        resultHtml += '</div><div class="o"></div></div>';
	        
	        $('#trending-results').html(resultHtml);
	        
	        // 使用分页类生成分页
	        var currentUrl = window.location.href;
	        var baseUrl = currentUrl.replace(/[&?]p=\d+/, ''); // 移除 p 参数
	        var pagination = new Pagination({
	            container: '#pagination-container',
	            baseUrl: baseUrl,
	            currentPage: data.p,
	            totalSize: data.totalsize,
	            pageSize: data.pagesize,
	            listSize: 8,
	            useUrlNavigation: true
	        });
	        
	        pagination.generate();
	    }
	});
	
	// 定义全局 JSONP 回调函数
	window.trendingCallback = function(data) {
	    return data;
	};
</script>

