/* 表单样式 */
.union-text-muted {
    margin-bottom: 15px;
    font-size: 14px;
    color: var(--text-muted-color);
}

.union-form-label {
    display: block;
    margin-bottom: 5px;
    font-size: 14px;
    color: var(--text-color);
}

.union-form-control {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid var(--border-color);
    border-radius: 0.375rem;
    background-color: var(--bg-input-color);
    color: var(--text-color);
    transition: all 0.3s ease;
}

.union-form-control:focus {
    border-color: var(--primary-color);
    outline: none;
    box-shadow: 0 0 0 3px var(--focus-ring-color);
}

.union-form-label.union-required::after {
    content: '*';
    color: var(--error-color);
    margin-left: 4px;
}

/* 暗黑模式变量 */
:root {
    --text-muted-color: #64748b;
    --text-color: #1e293b;
    --bg-input-color: #fff;
