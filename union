<script src="https://file.ipadown.com/tophub/assets/js/statistics.js" type="text/javascript"></script>    <script>
        $(function() {
            
            // FAQ点击展开/收起功能
            $('.faq-question').on('click', function() {
                let parent = $(this).parent('.faq-item');
                if(parent.hasClass('active')) {
                    parent.removeClass('active');
                } else {
                    // 可选：关闭其他已打开的FAQ项
                    // $('.faq-item').removeClass('active');
                    parent.addClass('active');
                }
            });
            
            // 自定义模态框处理
            $('[data-union-toggle="modal"]').on('click', function() {
                var target = $(this).attr('data-union-target');
                $(target).addClass('show');
                $('body').addClass('union-modal-open');
            });
            
            $('[data-union-dismiss="modal"]').on('click', function() {
                $(this).closest('.union-modal').removeClass('show');
                $('body').removeClass('union-modal-open');
            });
            
            // 点击模态框背景关闭模态框
            $('.union-modal').on('click', function(e) {
                if ($(e.target).hasClass('union-modal')) {
                    $(this).removeClass('show');
                    $('body').removeClass('union-modal-open');
                }
            });
            
            // 表单提交处理
            $('#unionForm').on('submit', function(e) {
                e.preventDefault();
                
                // 验证表单
                let contactPhone = $('#contact_phone').val();
                let contactQQ = $('#contact_qq').val();
                let contactWechat = $('#contact_wechat').val();
                let contactEmail = $('#contact_email').val();
                let projectName = $('#project_name').val();
                
                if (!contactPhone && !contactQQ && !contactWechat) {
                    alert('请至少填写一种联系方式（电话、QQ或微信）');
                    return false;
                }
                
                // 提交表单
                $.ajax({
                    url: $(this).attr('action'),
                    type: 'POST',
                    data: $(this).serialize(),
                    dataType: 'json',
                    success: function(response) {
                        if (!response.error) {
                            alert(response.data.msg);
                            $('#joinModal').removeClass('show');
                            $('body').removeClass('union-modal-open');
                            if (response.data.status == 1) {
                                setTimeout(function() {
                                    window.location.reload();
                                }, 1500);
                            }
                        } else {
                            alert(response.msg);
                        }
                    },
                    error: function() {
                        alert('提交失败，请稍后重试');
                    }
                });
            });
        });
    </script>
