<script>
$(document).ready(function() {
    // 获取当前页面的 URL
    var currentUrl = window.location.href;
    // 提取当前页面的域名部分
    var domain = window.location.origin;
    var activeElement = null;
    
    // 遍历所有的 <a> 标签
    $('.documentation-list a').each(function() {
        // 获取当前 <a> 标签的 href 属性值
        var href = $(this).attr('href');
        // 如果 href 以当前页面的域名开头，则将域名部分去除，只保留相对路径
        if (href.startsWith(domain)) {
            href = href.replace(domain, '');
        }
        // 检查 href 是否与当前页面的 URL 相匹配
        if (href === window.location.pathname) {
            // 如果匹配，为匹配的 <a> 标签添加指定的 class
            $(this).addClass('w--current');
            activeElement = $(this);
            
            // 如果匹配的是子菜单项，展开其父菜单
            var parentLi = $(this).closest('li').parent('ul').parent('li');
            if (parentLi.length) {
                parentLi.addClass('active');
            }
        }
    });
    
    // 如果找到了匹配的菜单项，将其滚动到可见区域
    if (activeElement) {
        // 延迟执行，确保DOM已完全加载
        setTimeout(function() {
            // 获取左侧菜单容器
            var container = $('.docs-col-left');
            // 获取选中元素的位置
            var elemTop = activeElement.offset().top;
            var elemBottom = elemTop + activeElement.outerHeight();
            // 获取容器的可见区域
            var containerTop = container.offset().top;
            var containerBottom = containerTop + container.height();
            
            // 如果元素不在可见区域内，滚动到元素位置
            if (elemTop < containerTop || elemBottom > containerBottom) {
                // 计算滚动位置，使元素在容器中居中显示
                var scrollTo = elemTop - containerTop - (container.height() / 2) + (activeElement.outerHeight() / 2);
                container.animate({
                    scrollTop: container.scrollTop() + scrollTo
                }, 300);
            }
        }, 100);
    }
});
</script>
